# Porta do servidor NestJS
PORT=3000

# Ambiente: em "production" o CORS é restrito às origens de CORS_ORIGIN
NODE_ENV=development

# Origens liberadas no CORS em produção (separadas por vírgula)
# Ex.: https://binaryfi.vercel.app,https://www.binaryfi.app
CORS_ORIGIN=

# Spotify Web API (opcional) — fonte prioritária das capas.
# Sem estas chaves o backend usa Deezer -> iTunes -> fallback.
# Crie um app em https://developer.spotify.com/dashboard e use Client Credentials.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
